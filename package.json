{
  "name": "@epotocko/node-libxslt",
  "version": "1.0.0-alpha.0",
  "description": "Node.js bindings for libxslt, with a minimal libxml2 XPath API, built on node-addon-api",
  "main": "index.js",
  "files": [
    "index.js",
    "xpath.js",
    "binding.gyp",
    "src/"
  ],
  "gypfile": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp rebuild",
    "test": "mocha",
    "test:matrix": "bash scripts/test-matrix.sh",
    "parity:capture": "bash parity/capture.sh"
  },
  "keywords": [
    "xml",
    "xsl",
    "xslt",
    "xpath",
    "libxslt",
    "libxml2",
    "bindings"
  ],
  "author": "Alban Mouton <alban.mouton@gmail.com>",
  "contributors": [
    "Rui Azevedo <ruihfazevedo@gmail.com> (http://www.r-site.net/)",
    "Edward Potocko"
  ],
  "homepage": "https://github.com/epotocko/node-libxslt",
  "bugs": {
    "url": "https://github.com/epotocko/node-libxslt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epotocko/node-libxslt.git"
  },
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "mocha": "^12.0.3"
  }
}
